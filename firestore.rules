rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function valid() {
   let d = request.resource.data;
   return d.keys().hasAll(['brief','plan','source','updatedAt']) && d.keys().hasOnly(['brief','plan','source','updatedAt'])
    && d.brief is map && d.plan is map && d.updatedAt is number && d.source in ['demo','gemini']
    && d.brief.keys().hasAll(['name','type','date','location','guests','budget','currency','preferences'])
    && d.brief.keys().hasOnly(['name','type','date','location','guests','budget','currency','preferences'])
    && d.brief.name is string && d.brief.name.size() >= 3 && d.brief.name.size() <= 90
    && d.brief.type in ['Wedding','Birthday','Community'] && d.brief.date is string && d.brief.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && d.brief.location is string && d.brief.location.size() >= 2 && d.brief.location.size() <= 100
    && d.brief.guests is int && d.brief.guests >= 1 && d.brief.guests <= 10000
    && d.brief.budget is number && d.brief.budget >= 1000 && d.brief.budget <= 100000000
    && d.brief.currency == 'INR' && d.brief.preferences is string && d.brief.preferences.size() <= 1500
    && d.plan.keys().hasAll(['summary','budget','tasks','vendors','ideas']) && d.plan.keys().hasOnly(['summary','budget','tasks','vendors','ideas'])
    && d.plan.summary is string && d.plan.summary.size() <= 1000
    && d.plan.budget is list && d.plan.budget.size() >= 1 && d.plan.budget.size() <= 20
    && d.plan.tasks is list && d.plan.tasks.size() >= 1 && d.plan.tasks.size() <= 40
    && d.plan.vendors is list && d.plan.vendors.size() >= 1 && d.plan.vendors.size() <= 20
    && d.plan.ideas is list && d.plan.ideas.size() >= 1 && d.plan.ideas.size() <= 10
    && d.size() == 4;
  }
  match /users/{uid}/events/{eventId} {
   allow read, delete: if owner(uid);
   allow create, update: if owner(uid) && valid();
  }
  match /{document=**} { allow read, write: if false; }
 }
}
